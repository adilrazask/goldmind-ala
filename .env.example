# ==============================================================================
# GoldMind ALA & Delta Exchange Configuration Template
# All secrets must be supplied via local environment variables.
# NEVER commit your real API keys or secrets to Git.
# ==============================================================================

# Operating Mode
ALA_MODE=RESEARCH_ONLY
ALA_ENABLE_LIVE_TRADING=NO

# Delta Exchange API Authentication (Get from https://india.delta.exchange/settings/api-keys)
DELTA_API_KEY=your_delta_exchange_api_key_here
DELTA_API_SECRET=your_delta_exchange_api_secret_here

# Delta Environment Selection:
# Options: INDIA_TESTNET (Default/Safe), INDIA_PRODUCTION, GLOBAL_TESTNET, GLOBAL_PRODUCTION
DELTA_ENVIRONMENT=INDIA_TESTNET

# Optional Custom Endpoint Overrides (Leave empty to use official defaults)
# DELTA_API_BASE_URL=https://cdn-ind.testnet.deltaex.org
# DELTA_PUBLIC_WEBSOCKET_URL=wss://socket-ind.testnet.deltaex.org
# DELTA_PRIVATE_WEBSOCKET_URL=wss://socket-ind.testnet.deltaex.org

# Delta Trading Execution Mode:
# "PAPER" = Mode A (Real live market data, simulated orders & fills - Recommended)
# "LIVE"  = Mode B (Real exchange orders - Requires explicit double authorization)
DELTA_TRADING_MODE=PAPER
DELTA_ENABLE_LIVE_TRADING=NO

# Delta Network & Safety Thresholds
DELTA_REQUEST_TIMEOUT=10.0
DELTA_STALE_DATA_THRESHOLD=15.0
DELTA_RECONNECT_DELAY=3.0
DELTA_MAX_RECONNECT=5

# Voice Security Passphrase (Initial configuration default: "30th July")
ALA_VOICE_PASSPHRASE="30th July"
ALA_VOICE_PASSPHRASE_ENABLED=true
ALA_VOICE_MAX_FAILURES=3
ALA_VOICE_LOCKOUT_SEC=300
ALA_VOICE_LANG=en-US

# Central Deterministic Risk Engine Limits
ALA_MAX_RISK_PER_TRADE=0.25
ALA_MAX_DAILY_LOSS=1.0
ALA_MAX_OPEN_POSITIONS=3
ALA_MAX_SPREAD_POINTS=35
ALA_MAX_SLIPPAGE_POINTS=20
ALA_DAILY_START_EQUITY=10000.0

# Database Storage
DATABASE_URL=sqlite:///backend/data/ala_database.sqlite3
